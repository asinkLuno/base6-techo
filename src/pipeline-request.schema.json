          "title": "Draw Hlines",
          "type": "boolean"
        },
        "draw_vlines": {
          "default": false,
          "title": "Draw Vlines",
          "type": "boolean"
        },
        "draw_dots": {
          "default": false,
          "title": "Draw Dots",
          "type": "boolean"
        },
        "hline_edge_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
