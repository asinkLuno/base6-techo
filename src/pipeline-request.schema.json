            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vline Edge Width"
        },
        "dot_center_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dot Center Color"
        },
        "hline_header": {
          "default": false,
          "title": "Hline Header",
          "type": "boolean"
        },
        "hline_footer": {
          "default": false,
          "title": "Hline Footer",
          "type": "boolean"
        },
        "hline_inner": {
          "default": false,
          "title": "Hline Inner",
          "type": "boolean"
        },
        "hline_outer": {
          "default": false,
          "title": "Hline Outer",
          "type": "boolean"
        },
        "vline_header": {
          "default": false,
          "title": "Vline Header",
          "type": "boolean"
        },
        "vline_footer": {
          "default": false,
          "title": "Vline Footer",
          "type": "boolean"
        },
        "vline_inner": {
          "default": false,
          "title": "Vline Inner",
          "type": "boolean"
        },
        "vline_outer": {
          "default": false,
          "title": "Vline Outer",
          "type": "boolean"
        },
        "dot_header": {
          "default": false,
          "title": "Dot Header",
          "type": "boolean"
        },
        "dot_footer": {
          "default": false,
          "title": "Dot Footer",
          "type": "boolean"
        },
        "dot_inner": {
          "default": false,
          "title": "Dot Inner",
          "type": "boolean"
        },
        "dot_outer": {
          "default": false,
          "title": "Dot Outer",
          "type": "boolean"
        },
        "dot_spacing": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dot Spacing"
        },
        "dot_radius": {
          "default": 0.3,
          "title": "Dot Radius",
          "type": "number"
        },
        "margin_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin X"
        },
        "margin_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Color"
        },
        "vline_spacing": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vline Spacing"
        }
      },
      "title": "BasicPatternRequest",
      "type": "object"
    },
    "BindRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "enum": [
                "booklet",
                "thread"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "booklet",
          "title": "Mode"
        },
        "sheets_per_group": {
          "default": 4,
          "minimum": 1,
          "title": "Sheets Per Group",
          "type": "integer"
        }
      },
      "title": "BindRequest",
      "type": "object"
    },
    "DocumentRequest": {
      "additionalProperties": false,
      "properties": {
        "page_count": {
          "default": 32,
          "maximum": 500,
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "show_header": {
          "default": true,
          "title": "Show Header",
          "type": "boolean"
        },
        "binding_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Text"
        },
        "binding_text_2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Text 2"
        },
        "binding_text_size": {
          "default": 8,
          "title": "Binding Text Size",
          "type": "number"
        },
        "binding_text_2_size": {
          "default": 8,
          "title": "Binding Text 2 Size",
          "type": "number"
        },
        "binding_text_spacing": {
          "default": 5,
          "title": "Binding Text Spacing",
          "type": "number"
        },
        "binding_text_font": {
          "default": "\\sffamily",
          "title": "Binding Text Font",
          "type": "string"
        },
        "header_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Date"
        },
        "header_date_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Date End"
        },
        "header_date_format": {
          "default": "yyyy-MM-dd",
          "title": "Header Date Format",
          "type": "string"
        },
        "header_date_locale": {
          "default": "zh_CN",
          "title": "Header Date Locale",
          "type": "string"
        },
        "header_parity": {
          "default": "both",
          "enum": [
            "odd",
            "even",
            "both"
          ],
          "title": "Header Parity",
          "type": "string"
        },
        "header_date_size": {
          "default": 8,
          "title": "Header Date Size",
          "type": "number"
        },
        "header_date_font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Date Font"
        },
        "header_date_position": {
          "default": "center",
          "enum": [
            "center",
            "binding",
            "outer"
          ],
          "title": "Header Date Position",
          "type": "string"
        },
        "header_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Text"
        },
        "header_text_2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Text 2"
        },
        "header_text_size": {
          "default": 8,
          "title": "Header Text Size",
          "type": "number"
        },
        "header_text_2_size": {
          "default": 8,
          "title": "Header Text 2 Size",
          "type": "number"
        },
        "header_text_spacing": {
          "default": 5,
          "title": "Header Text Spacing",
          "type": "number"
        },
        "non_binding_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Non Binding Text"
        },
        "non_binding_text_2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Non Binding Text 2"
        },
        "non_binding_text_size": {
          "default": 8,
          "title": "Non Binding Text Size",
          "type": "number"
        },
        "non_binding_text_2_size": {
          "default": 8,
          "title": "Non Binding Text 2 Size",
          "type": "number"
        },
        "non_binding_text_spacing": {
          "default": 5,
          "title": "Non Binding Text Spacing",
          "type": "number"
        },
        "footer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Text"
        },
        "footer_text_2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Text 2"
        },
        "footer_text_size": {
          "default": 8,
          "title": "Footer Text Size",
          "type": "number"
        },
        "footer_text_2_size": {
          "default": 8,
          "title": "Footer Text 2 Size",
          "type": "number"
        },
        "footer_text_spacing": {
          "default": 5,
          "title": "Footer Text Spacing",
          "type": "number"
        }
      },
      "title": "DocumentRequest",
      "type": "object"
    },
    "MidoriPatternRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "midori",
          "default": "midori",
          "title": "Kind",
          "type": "string"
        },
        "spacing": {
          "default": 5,
          "title": "Spacing",
          "type": "number"
        },
        "gap": {
          "default": 1,
          "title": "Gap",
          "type": "number"
        },
        "edge_extension": {
          "default": 1.2,
          "title": "Edge Extension",
          "type": "number"
        },
        "dot_frequency": {
          "default": 10,
          "title": "Dot Frequency",
          "type": "integer"
        },
        "dot_radius": {
          "default": 0.4,
          "title": "Dot Radius",
          "type": "number"
        },
        "line_width": {
          "default": 0.7,
          "title": "Line Width",
          "type": "number"
        },
        "line_color": {
          "default": "#99FFFF",
          "title": "Line Color",
          "type": "string"
        },
        "dot_color": {
          "default": "#99FFFF",
          "title": "Dot Color",
          "type": "string"
        },
        "header": {
          "default": false,
          "title": "Header",
          "type": "boolean"
        },
        "footer": {
          "default": false,
          "title": "Footer",
          "type": "boolean"
        },
        "inner": {
          "default": false,
          "title": "Inner",
          "type": "boolean"
        },
        "outer": {
          "default": false,
          "title": "Outer",
          "type": "boolean"
        }
      },
      "title": "MidoriPatternRequest",
      "type": "object"
    },
    "PageRequest": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 148,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 210,
          "title": "Height",
          "type": "number"
        },
        "header": {
          "default": 10,
          "title": "Header",
          "type": "number"
        },
        "footer": {
          "default": 10,
          "title": "Footer",
          "type": "number"
        },
        "binding": {
          "default": 15,
          "title": "Binding",
          "type": "number"
        },
        "non_binding": {
          "default": 8,
          "title": "Non Binding",
          "type": "number"
        }
      },
      "title": "PageRequest",
      "type": "object"
    },
    "RenderSectionRequest": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "$ref": "#/$defs/PageRequest"
        },
        "document": {
          "$ref": "#/$defs/DocumentRequest"
        },
        "pattern": {
          "discriminator": {
            "mapping": {
              "basic": "#/$defs/BasicPatternRequest",
              "midori": "#/$defs/MidoriPatternRequest",
              "timeline": "#/$defs/TimelinePatternRequest"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BasicPatternRequest"
            },
            {
              "$ref": "#/$defs/MidoriPatternRequest"
            },
            {
              "$ref": "#/$defs/TimelinePatternRequest"
            }
          ],
          "title": "Pattern"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RenderSectionRequest",
      "type": "object"
    },
    "TimelinePatternRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "timeline",
          "default": "timeline",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "default": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "default": 26,
          "title": "End",
          "type": "integer"
        },
        "pages": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Pages",
          "type": "integer"
        },
        "swap": {
          "default": false,
          "title": "Swap",
          "type": "boolean"
        },
        "line_color": {
          "default": "#7A7A7A",
          "title": "Line Color",
          "type": "string"
        },
        "line_width": {
          "default": 1.1381102362204725,
          "title": "Line Width",
          "type": "number"
        },
        "label_size": {
          "default": 10.2,
          "title": "Label Size",
          "type": "number"
        },
        "city_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City Name"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "daylight_color": {
          "default": "#E5B93F",
          "title": "Daylight Color",
          "type": "string"
        },
        "night_color": {
          "default": "#496A9F",
          "title": "Night Color",
          "type": "string"
        }
      },
      "title": "TimelinePatternRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "output": {
      "title": "Output",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/RenderSectionRequest"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "bind": {
      "$ref": "#/$defs/BindRequest"
    }
  },
  "required": [
    "output",
    "sections"
  ],
  "title": "RunPipelineRequest",
  "type": "object"
}
